# LLM API Keys
# Get your OpenAI key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
# Get your Anthropic key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
# Get your Groq key from: https://console.groq.com/keys
GROQ_API_KEY=gsk-your-groq-api-key-here
# Get your Fireworks key from: https://fireworks.ai/account/api-keys
FIREWORKS_API_KEY=fw-your-fireworks-api-key-here
# Get your Gemini key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# LLM Configuration
# Primary provider: openai, anthropic, groq, fireworks, or gemini
LLM_PROVIDER=openai
# OpenAI model for extraction (primary)
LLM_MODEL=gpt-4o-2024-08-06
# Anthropic model for failover
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# Groq model (fast inference with Llama models)
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Fireworks model (supports up to 30 images per request, prompt caching)
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct
# Gemini model (Flash-Lite for speed optimization)
GEMINI_MODEL=gemini-2.0-flash-lite

# Smart Routing Configuration (Speed Phase 3)
# Enable smart routing for document-aware provider selection
ROUTING_ENABLED=false
# Routing strategy: auto, speed, accuracy, cost
ROUTING_STRATEGY=speed

# Speed Optimization Settings (Phase 5)
# DPI for rendering scanned PDFs (lower = faster, default 300, try 150 for speed)
RENDER_DPI=300
# Maximum characters for text extraction (default 30000)
MAX_TEXT_CHARS=30000
# Maximum characters for table extraction (default 10000)
MAX_TABLE_CHARS=10000
# Enable prompt caching for supported providers (Fireworks)
ENABLE_PROMPT_CACHING=true
# Enable parallel text/table extraction (default true)
PARALLEL_PARSING=true

# Application Settings
# Maximum PDF file size in megabytes
MAX_FILE_SIZE_MB=10
# Maximum processing time before timeout (seconds)
PROCESSING_TIMEOUT_SECONDS=15
# Confidence threshold below which requires human review (0.0-1.0)
CONFIDENCE_THRESHOLD=0.90

# UI/API Configuration
# Base URL for API server (used by Streamlit UI)
API_BASE_URL=http://localhost:8000
# Timeout for quick API requests in seconds (health, list, load)
API_TIMEOUT_SECONDS=10
